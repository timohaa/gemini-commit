#!/bin/zsh

# Smart git commit using Gemini AI

show_help() {
  cat <<'EOF'
Usage: commit [options] [custom instructions...]

Smart git commit using Gemini AI.

Options:
  -n, --no-yolo     Disable YOLO mode (ask for confirmation before executing actions)
  -p, --push        Automatically push after successful commit(s)
  -h, --help        Show this help message
  --                Treat everything after as custom instructions (even if it starts with -)

Examples:
  commit
  commit "only index.js changes"
  commit --no-yolo
  commit -p "fix bug in parser"
EOF
}

# 1. Parse options and arguments (before any git checks, so --help always works)
yolo=true
push_after=false
args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--no-yolo|--safe)
      yolo=false
      shift
      ;;
    -p|--push)
      push_after=true
      shift
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    --)
      shift
      args+=("$@")
      break
      ;;
    -*)
      echo "Error: Unknown option: $1" >&2
      echo "Run 'commit --help' for usage." >&2
      exit 2
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

custom_instructions="${args[*]}"

# 2. Check that the gemini CLI is available
if ! command -v gemini >/dev/null 2>&1; then
  echo "Error: 'gemini' command not found. Install the Gemini CLI first." >&2
  exit 1
fi

# 3. Check if we are inside a git repository
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: Not a git repository (or any of the parent directories)" >&2
  exit 1
fi

# 4. Check if there are any changes to commit (including untracked files)
if [[ -z "$(git status --porcelain)" ]]; then
  echo "Nothing to commit (working tree clean)"
  exit 0
fi

# 5. Construct the prompt
base_prompt="commit to git. this is an automatic prompt run from the command line. if there are lots of changes, feel free to split into separate commits. see previous commits for commit message style reference."

if [[ -n "$custom_instructions" ]]; then
  base_prompt="${base_prompt}

User instructions for this commit:
${custom_instructions}"
fi

if [[ "$push_after" == "true" ]]; then
  base_prompt="${base_prompt}

Once the commit is (or commits are) successfully completed, push the committed branches to the remote repository (e.g. using 'git push')."
fi

# 6. Run Gemini
gemini_args=()
[[ "$yolo" == "true" ]] && gemini_args+=(-y)
gemini_args+=(-i "$base_prompt")

gemini "${gemini_args[@]}"
