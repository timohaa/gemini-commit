#!/bin/sh

# Smart git commit using the Antigravity CLI
#
# Written in POSIX sh so it runs under sh, bash, zsh, dash, ash and ksh alike.

VERSION="2.2.0"

# --quick and --deep resolve against 'agy models' at runtime rather than naming a
# model literally, so they keep pointing at something sensible as models come and
# go. Patterns are tried in order of preference; within one pattern the first
# match wins, since 'agy models' lists newest first. These fallbacks are only
# used when 'agy models' cannot be read.
QUICK_PATTERNS='*flash*-low *-low *flash* *'
DEEP_PATTERNS='*pro*-high *pro* *-high *'
QUICK_FALLBACK="gemini-3.6-flash-low"
DEEP_FALLBACK="gemini-3.1-pro-high"

# Caps on how much repository context is inlined into the prompt
MAX_SUBJECTS=20
MAX_FULL_MESSAGES=5      # commits shown in full, bodies included
MAX_FULL_LOG_LINES=80    # safety valve for repos with very long bodies
MAX_STATUS_LINES=100
MAX_DIFFSTAT_LINES=100

# A literal newline, since POSIX sh has no $'\n'
NL='
'

# Print the usage/help text to stdout.
show_help() {
  cat <<'EOF'
Usage: commit [options] [custom instructions...]

Smart git commit using the Antigravity CLI.

Options:
  -n, --no-yolo     Disable YOLO mode (ask for confirmation before executing actions)
      --safe        Alias for --no-yolo
  -p, --push        Automatically push after successful commit(s)
  -q, --quick       Use the fastest low-effort model listed by 'agy models'
  -d, --deep        Use the strongest high-effort model listed by 'agy models'
      --model NAME  Use a specific model (see 'agy models')
      --effort STR  Reasoning effort: low, medium or high
      --show-prompt Print the generated prompt and exit without running agy
  -h, --help        Show this help message
  -v, --version     Show version
  --                Treat everything after as custom instructions (even if it starts with -)

Examples:
  commit
  commit "only index.js changes"
  commit --quick
  commit --deep "split the refactor and the bugfix into separate commits"
  commit --no-yolo
  commit -p "fix bug in parser"
EOF
}

# Print at most <max> lines of <text>, noting how much was cut.
# Uses cap_-prefixed globals rather than 'local', which is not POSIX.
cap() {
  cap_max=$1
  cap_text=$2
  [ -n "$cap_text" ] || return 0
  cap_n=$(printf '%s\n' "$cap_text" | wc -l)
  cap_n=$((cap_n)) # some wc implementations pad the count with leading spaces
  if [ "$cap_n" -gt "$cap_max" ]; then
    # sed rather than head: head exits early and can make the upstream printf
    # report a broken pipe when SIGPIPE is inherited as ignored.
    printf '%s\n' "$cap_text" | sed -n "1,${cap_max}p"
    printf '... (%s lines total, truncated)\n' "$cap_n"
  else
    printf '%s\n' "$cap_text"
  fi
}

# Print the first model in $models matching one of the given glob patterns,
# trying the patterns left to right. Returns 1 if nothing matched at all.
# Globbing is off throughout: both the pattern list and the model list are
# deliberately unquoted (for word splitting, and so 'case' treats the pattern as
# a glob), and neither should ever expand against files in the current directory.
pick_model() {
  set -f
  pick_result=""
  for pick_pat in $1; do
    for pick_line in $models; do
      case "$pick_line" in
        $pick_pat) pick_result="$pick_line" ;;
      esac
      [ -z "$pick_result" ] || break
    done
    [ -z "$pick_result" ] || break
  done
  set +f
  [ -n "$pick_result" ] || return 1
  printf '%s\n' "$pick_result"
}

# 1. Parse options and arguments (before any git checks, so --help always works)
yolo=true
push_after=false
show_prompt=false
model=""
model_role=""
effort=""
args=""

while [ $# -gt 0 ]; do
  case "$1" in
    -n|--no-yolo|--safe)
      yolo=false
      shift
      ;;
    -p|--push)
      push_after=true
      shift
      ;;
    -q|--quick)
      model=""
      model_role="quick"
      shift
      ;;
    -d|--deep)
      model=""
      model_role="deep"
      shift
      ;;
    --model)
      if [ -z "${2-}" ]; then
        printf '%s\n' "Error: --model requires a model name (see 'agy models')." >&2
        exit 2
      fi
      model="$2"
      model_role=""
      shift 2
      ;;
    --model=*)
      model="${1#--model=}"
      model_role=""
      if [ -z "$model" ]; then
        printf '%s\n' "Error: --model requires a model name (see 'agy models')." >&2
        exit 2
      fi
      shift
      ;;
    --effort|--effort=*)
      case "$1" in
        --effort=*)
          effort="${1#--effort=}"
          shift
          ;;
        *)
          if [ -n "${2-}" ]; then
            effort="$2"
            shift 2
          else
            printf '%s\n' "Error: --effort requires a value: low, medium or high" >&2
            exit 2
          fi
          ;;
      esac
      case "$effort" in
        low|medium|high) ;;
        *)
          printf '%s\n' "Error: --effort must be one of: low, medium, high" >&2
          exit 2
          ;;
      esac
      ;;
    --show-prompt)
      show_prompt=true
      shift
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    -v|--version)
      printf '%s\n' "commit $VERSION"
      exit 0
      ;;
    --)
      shift
      for arg in "$@"; do
        args="${args:+${args} }${arg}"
      done
      break
      ;;
    -*)
      printf '%s\n' "Error: Unknown option: $1" >&2
      printf '%s\n' "Run 'commit --help' for usage." >&2
      exit 2
      ;;
    *)
      # Joined with spaces rather than one-per-line: an unquoted
      # 'commit split into two commits' must stay a single instruction,
      # not degenerate into four one-word ones.
      args="${args:+${args} }${1}"
      shift
      ;;
  esac
done

# 2. Check that the agy CLI is available. --show-prompt never runs agy, so it
#    stays usable on machines without the CLI; model resolution then simply
#    falls back to the hardcoded defaults.
if [ "$show_prompt" != "true" ] && ! command -v agy >/dev/null 2>&1; then
  printf '%s\n' "Error: 'agy' command not found. Install the Antigravity CLI first." >&2
  exit 1
fi

# 3. Check if we are inside a git work tree. rev-parse exits 0 and prints
#    "false" in bare repos and inside .git, so test the output, not the status.
if [ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" != "true" ]; then
  printf '%s\n' "Error: Not inside a git work tree" >&2
  exit 1
fi

# 4. Check if there are any changes to commit (including untracked files)
git_status="$(git status --porcelain)"
if [ -z "$git_status" ]; then
  printf '%s\n' "Nothing to commit (working tree clean)"
  exit 0
fi

# 5. Resolve the model. --quick/--deep are picked from 'agy models'; an explicit
#    --model is validated against the same list. A model that is not listed is a
#    warning rather than an error, so a run never fails just over model naming.
models=""
if [ -n "$model" ] || [ -n "$model_role" ]; then
  models="$(agy models 2>/dev/null)"
fi

case "$model_role" in
  quick)
    model="$(pick_model "$QUICK_PATTERNS")" || model="$QUICK_FALLBACK"
    ;;
  deep)
    model="$(pick_model "$DEEP_PATTERNS")" || model="$DEEP_FALLBACK"
    ;;
esac

# NL-padding on both sides makes this an exact per-line match (the glob only hits
# when $model is a whole line of $models, not a substring of a longer name) without
# a bash herestring, which is not POSIX.
if [ -n "$model" ] && [ -n "$models" ]; then
  case "${NL}${models}${NL}" in
    *"${NL}${model}${NL}"*) ;;
    *)
      printf '%s\n' "Warning: model '$model' not listed by 'agy models'; using agy's default." >&2
      model=""
      ;;
  esac
fi

# 6. Gather the repository context up front, so the agent does not have to
#    re-derive it (branch, log, status, diffstat) itself on every run.
branch="$(git branch --show-current 2>/dev/null)"
if [ -z "$branch" ]; then
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
  if [ -z "$branch" ] || [ "$branch" = "HEAD" ]; then
    branch="(detached HEAD)"
  fi
fi
has_head="$(git rev-parse --verify -q HEAD 2>/dev/null)"

context="Branch: ${branch}"

if [ -n "$has_head" ]; then
  # Co-author trailers are stripped rather than shown and disclaimed: left in, they read
  # as part of the house style and get copied onto commits the co-author had no hand in.
  # Case-insensitive and anchored, since git treats trailer keys case-insensitively but a
  # body line merely mentioning the phrase should survive.
  context="${context}${NL}${NL}Recent commit messages in full, newest first — match this body format, line wrapping and trailer convention:${NL}"
  context="${context}$(cap "$MAX_FULL_LOG_LINES" "$(git log -n "$MAX_FULL_MESSAGES" --pretty='format:=== %h%n%B' | grep -iv '^[[:space:]]*co-authored-by:')")"

  context="${context}${NL}${NL}Recent commit subjects, a wider sample (the newest few repeat the messages above) — match this subject style: mood, capitalization, prefix convention, length:${NL}"
  context="${context}$(cap "$MAX_SUBJECTS" "$(git log --pretty=%s -n "$MAX_SUBJECTS")")"
else
  context="${context}${NL}${NL}This repository has no commits yet, so there is no existing style to match."
fi

context="${context}${NL}${NL}Changed files (git status --porcelain):${NL}"
context="${context}$(cap "$MAX_STATUS_LINES" "$git_status")"

if [ -n "$has_head" ]; then
  context="${context}${NL}${NL}Diffstat vs HEAD (untracked files are not included here):${NL}"
  context="${context}$(cap "$MAX_DIFFSTAT_LINES" "$(git diff --stat HEAD)")"
fi

# 7. Construct the prompt
base_prompt=$(cat <<EOF
You are running non-interactively from a \`commit\` shell wrapper, inside a git repository.

## Repository context

This was gathered for you already — do not re-run \`git log\`, \`git status\` or \`git diff --stat\`
just to orient yourself.

${context}

## What to do

1. Analyze the changes first. Read the actual diffs for the files above (\`git diff\`,
   \`git diff --cached\`, or read untracked files directly) and work out what changed and why
   before deciding anything.
2. Group the changes into commits — one logical change per commit. If it is all one coherent
   change, one commit is correct; do not split for the sake of splitting.
3. Order the commits logically and chronologically: foundational and depended-upon changes
   first, then what builds on them (a new helper before its callers, a config or ignore change
   before the code that relies on it). The history should read in the order the work would
   naturally have been done, and each commit should be self-consistent on its own.
4. Write each message in the style of the recent messages above: match the subject
   convention, and the body format where a body is warranted. Follow the structural
   conventions (bullet style, wrapping width, prefixes) — but do not add a body just
   because earlier commits have one, and do not carry over a trailer unless it genuinely
   applies to this commit.
5. Stage per commit with explicit paths (\`git add <paths>\`) and commit. Do not \`git add -A\`
   once and dump everything into a single commit unless that genuinely is the right grouping.
EOF
)

if [ -n "$args" ]; then
  base_prompt="${base_prompt}${NL}${NL}## User instructions for this commit${NL}${args}"
fi

if [ "$push_after" = "true" ]; then
  base_prompt="${base_prompt}${NL}${NL}Once the commit is (or commits are) successfully completed, push the committed branches to the remote repository (e.g. using 'git push')."
fi

if [ "$show_prompt" = "true" ]; then
  printf '%s\n' "$base_prompt"
  exit 0
fi

# 8. Run Antigravity. Rebuild the positional parameters as agy's argument list;
#    the leading 'set --' is required because '--' above breaks out of the loop
#    without consuming the remaining arguments.
set --
[ "$yolo" = "true" ] && set -- "$@" --dangerously-skip-permissions
[ -n "$model" ] && set -- "$@" --model "$model"
[ -n "$effort" ] && set -- "$@" --effort "$effort"
set -- "$@" -i "$base_prompt"

agy "$@"
